<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.CloneContextController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="28" right="28" bottom="12" left="28"/></padding>
            <Label text="Clone Context" styleClass="screen-title"/>
            <Label text="Reproduce a business entity (customer, order, user…) from production to your local environment in minutes."
                   styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <VBox spacing="16">
                <padding><Insets top="4" right="28" bottom="16" left="28"/></padding>

                <!-- Entity -->
                <VBox styleClass="card" spacing="10">
                    <Label text="ENTITY" styleClass="section-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Entity type" styleClass="field-label"/>
                            <ComboBox fx:id="cmbEntity" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Entity ID" styleClass="field-label"/>
                            <TextField fx:id="tfEntityId" promptText="e.g. 12345"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Connections -->
                <VBox styleClass="card" spacing="10">
                    <Label text="CONNECTIONS" styleClass="section-label"/>
                    <CheckBox fx:id="chkExportMode" text="Export mode — save as .rrpkg file instead of live clone"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Source" styleClass="field-label"/>
                            <ComboBox fx:id="cmbSource" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTargetOrDir" text="Target" styleClass="field-label"/>
                            <ComboBox fx:id="cmbTarget" maxWidth="Infinity"/>
                            <HBox fx:id="hboxOutputDir" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                                <TextField fx:id="tfOutputDir" HBox.hgrow="ALWAYS" promptText="Output directory…"/>
                                <Button fx:id="btnBrowseDir" text="Browse…" onAction="#onBrowseDir"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Options -->
                <VBox styleClass="card" spacing="10">
                    <Label text="OPTIONS" styleClass="section-label"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Traversal depth" styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Slider fx:id="sliderDepth" prefWidth="180"/>
                                <Label fx:id="lblDepthValue" text="3" styleClass="hint-label"/>
                            </HBox>
                        </VBox>
                        <CheckBox fx:id="chkMaskPii" text="Mask PII (email, phone, address, IBAN, national ID)"/>
                    </HBox>
                </VBox>

                <!-- Bug context (visible in export mode) -->
                <VBox fx:id="paneBugContext" styleClass="card" spacing="10" visible="false" managed="false">
                    <Label text="BUG CONTEXT (OPTIONAL)" styleClass="section-label"/>
                    <Label text="Attach a bug report to this reproduction package." styleClass="screen-subtitle"/>
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Bug / Ticket ID" styleClass="field-label"/>
                            <TextField fx:id="tfBugId" promptText="JIRA-1234"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Title" styleClass="field-label"/>
                            <TextField fx:id="tfBugTitle" promptText="Short description"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Service" styleClass="field-label"/>
                            <TextField fx:id="tfBugService" promptText="orders-service"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Environment" styleClass="field-label"/>
                            <TextField fx:id="tfBugEnv" promptText="production"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Log -->
                <VBox styleClass="card" spacing="8">
                    <Label text="LOG" styleClass="section-label"/>
                    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="14"/>
                    <Label fx:id="lblStatus" text="Ready" styleClass="status-label"/>
                    <TextArea fx:id="taLog" prefHeight="120" editable="false" wrapText="true"
                              styleClass="log-area" promptText="Clone output appears here…"/>
                    <Label fx:id="lblExportedPath" styleClass="hint-label" visible="false" managed="false"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="16" left="28"/></padding>
            <Button fx:id="btnClone"  text="Clone Context" onAction="#onClone"  styleClass="accent-btn"/>
            <Button fx:id="btnExport" text="Export Package" onAction="#onExport" disable="true"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>

</BorderPane>
