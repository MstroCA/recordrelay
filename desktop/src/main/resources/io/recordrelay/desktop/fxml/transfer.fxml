<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.TransferController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="28" right="28" bottom="12" left="28"/></padding>
            <Label text="Transfer" styleClass="screen-title"/>
            <Label text="Select a connection — databases, tables and columns are loaded automatically."
                   styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <VBox spacing="16">
                <padding><Insets top="4" right="28" bottom="16" left="28"/></padding>

                <!-- Source + Target cards -->
                <HBox spacing="16">

                    <!-- SOURCE -->
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="SOURCE" styleClass="section-label"/>

                        <Label text="Connection" styleClass="field-label"/>
                        <ComboBox fx:id="cmbSrcConn" maxWidth="Infinity"/>

                        <Label text="Database" styleClass="field-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cmbSrcDb" maxWidth="Infinity" HBox.hgrow="ALWAYS" disable="true"/>
                            <Label fx:id="lblSrcDbLoading" text="Loading…" styleClass="hint-label"
                                   visible="false" managed="false"/>
                        </HBox>

                        <Label text="Table" styleClass="field-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cmbSrcTable" maxWidth="Infinity" HBox.hgrow="ALWAYS" disable="true"/>
                            <Label fx:id="lblSrcTblLoading" text="Loading…" styleClass="hint-label"
                                   visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                    <!-- TARGET -->
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="TARGET" styleClass="section-label"/>

                        <Label text="Connection" styleClass="field-label"/>
                        <ComboBox fx:id="cmbTgtConn" maxWidth="Infinity"/>

                        <Label text="Database" styleClass="field-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cmbTgtDb" maxWidth="Infinity" HBox.hgrow="ALWAYS" disable="true"/>
                            <Label fx:id="lblTgtDbLoading" text="Loading…" styleClass="hint-label"
                                   visible="false" managed="false"/>
                        </HBox>

                        <Label text="Table — pick existing or type a new name" styleClass="field-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cmbTgtTable" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      editable="true" disable="true"/>
                            <Label fx:id="lblTgtTblLoading" text="Loading…" styleClass="hint-label"
                                   visible="false" managed="false"/>
                        </HBox>

                        <Label fx:id="lblTgtNotFound" wrapText="true"
                               text="⚠ Table not found in target — it will be created on the first transfer."
                               styleClass="warn-label" visible="false" managed="false"/>
                    </VBox>

                </HBox>

                <!-- Column Mapping — visible once source table is selected -->
                <VBox fx:id="paneColumnMapping" styleClass="card" spacing="8"
                      visible="false" managed="false">
                    <Label text="COLUMN MAPPING" styleClass="section-label"/>
                    <Label wrapText="true" styleClass="screen-subtitle"
                           text="Uncheck to exclude a column. Edit Target Column to rename. Transform: upper / lower / trim / cast:int. Override Value: always write this literal instead of the source value."/>
                    <TableView fx:id="tblColumns" editable="true" prefHeight="220" maxHeight="380">
                        <columns>
                            <TableColumn fx:id="colEnabled"   text="✓"              prefWidth="38"/>
                            <TableColumn fx:id="colSrcCol"    text="Source Column"   prefWidth="160"/>
                            <TableColumn fx:id="colSrcType"   text="Type"            prefWidth="90"/>
                            <TableColumn fx:id="colTgtCol"    text="Target Column"   prefWidth="160"/>
                            <TableColumn fx:id="colTransform" text="Transform"       prefWidth="110"/>
                            <TableColumn fx:id="colOverride"  text="Override Value"  prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Job settings card -->
                <VBox styleClass="card" spacing="10">
                    <Label text="JOB SETTINGS" styleClass="section-label"/>
                    <GridPane hgap="12" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS" prefWidth="160"/>
                            <ColumnConstraints minWidth="120" prefWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                        </columnConstraints>

                        <Label text="Transfer mode:"   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cmbMode"      GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                        <Label text="Isolation:"       GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cmbIsolation" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>

                        <Label text="Chunk size:"      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="tfChunkSize" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="120"/>

                        <Label text="Mapping file:"    GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <HBox spacing="6"              GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3">
                            <TextField fx:id="tfMappingFile" HBox.hgrow="ALWAYS"
                                       promptText="Optional — JSON/YAML file overrides column mapping above"/>
                            <Button text="Browse…" onAction="#onBrowseMapping"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- Progress card -->
                <VBox styleClass="card" spacing="8">
                    <Label text="PROGRESS" styleClass="section-label"/>
                    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="18"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <Label fx:id="lblStatus"      text="Ready" styleClass="status-label"/>
                        <Label fx:id="lblTransferred" text="Transferred: 0 records"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="16" left="28"/></padding>
            <Button fx:id="btnStart"  text="Start Transfer" onAction="#onStart"  styleClass="accent-btn"/>
            <Button fx:id="btnCancel" text="Cancel"         onAction="#onCancel"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>

</BorderPane>
