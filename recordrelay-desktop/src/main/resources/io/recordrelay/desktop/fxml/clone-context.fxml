<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.CloneContextController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="28" right="28" bottom="12" left="28"/></padding>
            <Label text="%cc.title" styleClass="screen-title"/>
            <Label text="%cc.subtitle" styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <VBox spacing="16">
                <padding><Insets top="4" right="28" bottom="16" left="28"/></padding>

                <!-- Step 1: Connections -->
                <VBox styleClass="card" spacing="10">
                    <Label text="%cc.step1" styleClass="section-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="%cc.lbl.source" styleClass="field-label"/>
                            <ComboBox fx:id="cmbSource" maxWidth="Infinity" onAction="#onSourceChanged"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTargetHeader" text="%cc.lbl.target" styleClass="field-label"/>
                            <ComboBox fx:id="cmbTarget" maxWidth="Infinity"/>
                            <HBox fx:id="hboxOutputDir" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                                <TextField fx:id="tfOutputDir" HBox.hgrow="ALWAYS" promptText="%cc.lbl.outdir"/>
                                <Button fx:id="btnBrowseDir" text="%cc.btn.browse" onAction="#onBrowseDir"/>
                            </HBox>
                        </VBox>
                    </HBox>
                    <CheckBox fx:id="chkExportMode" text="%cc.chk.export"/>
                </VBox>

                <!-- Step 2: Tables -->
                <VBox styleClass="card" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="%cc.step2" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnLoadTables" text="%cc.btn.load" onAction="#onLoadTables"
                                disable="true"/>
                        <Label fx:id="lblTableCount" text="" styleClass="hint-label"/>
                    </HBox>
                    <Label text="%cc.hint.load" styleClass="screen-subtitle"/>
                    <!-- Root table, PK column and entity ID — all labels at top, fields at same level -->
                    <HBox spacing="12" alignment="TOP_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="%cc.lbl.root" styleClass="field-label"/>
                            <HBox spacing="6">
                                <ComboBox fx:id="cmbRootTable" HBox.hgrow="ALWAYS"
                                          promptText="%cc.hint.load" editable="true"/>
                                <Button fx:id="btnDetectRoot" text="%cc.btn.detect"
                                        onAction="#onDetectRoot" disable="true"
                                        styleClass="nav-btn"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="4" prefWidth="150">
                            <Label text="%cc.lbl.pk" styleClass="field-label"/>
                            <TextField fx:id="tfPkColumn" text="id" promptText="id"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="%cc.lbl.entity" styleClass="field-label"/>
                            <TextField fx:id="tfEntityId" promptText="12345"/>
                        </VBox>
                    </HBox>

                    <!-- Root suggestion panel — shown after detection -->
                    <VBox fx:id="rootSuggestPanel" spacing="6" visible="false" managed="false">
                        <Label text="%cc.suggest.hint" styleClass="hint-label"/>
                        <javafx.scene.layout.FlowPane fx:id="rootSuggestFlow" hgap="8" vgap="6"/>
                    </VBox>

                    <Label text="%cc.hint.fk" styleClass="hint-label"/>
                </VBox>

                <!-- Step 3: Options -->
                <VBox styleClass="card" spacing="10">
                    <Label text="%cc.step3" styleClass="section-label"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="%cc.lbl.depth" styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Slider fx:id="sliderDepth" prefWidth="200"/>
                                <Label fx:id="lblDepthValue" text="3" styleClass="hint-label"/>
                            </HBox>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <CheckBox fx:id="chkMaskPii" text="%cc.chk.pii"/>
                        <Separator orientation="VERTICAL"/>
                        <VBox spacing="4">
                            <Label text="%cc.lbl.conflict" styleClass="field-label"/>
                            <ComboBox fx:id="cmbConflict" prefWidth="200"/>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <VBox spacing="4">
                            <Label text="Start ID (START_AT)" styleClass="field-label"/>
                            <TextField fx:id="tfIdStart" prefWidth="120"
                                       promptText="e.g. 100000"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Step 4: Field Overrides -->
                <VBox styleClass="card" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="%cc.step4" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                        <Button text="%cc.btn.add" onAction="#onAddOverride"/>
                        <Button text="%cc.btn.remove" onAction="#onRemoveOverride"/>
                    </HBox>
                    <Label text="%cc.hint.override" styleClass="hint-label"/>
                    <TableView fx:id="tblOverrides" prefHeight="130" editable="true">
                        <columns>
                            <TableColumn fx:id="colOvrTable"  text="%cc.col.table"  prefWidth="160"/>
                            <TableColumn fx:id="colOvrColumn" text="%cc.col.column" prefWidth="160"/>
                            <TableColumn fx:id="colOvrValue"  text="%cc.col.value"  prefWidth="200"/>
                        </columns>
                        <placeholder>
                            <Label text="%cc.override.empty" styleClass="placeholder-hint"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Step 5: Satellite (companion) tables in a separate database -->
                <VBox styleClass="card" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Satellite Tables" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                        <Button text="%cc.btn.add" onAction="#onAddSatellite"/>
                        <Button text="%cc.btn.remove" onAction="#onRemoveSatellite"/>
                        <Button text="Save" onAction="#onSaveSatellites"/>
                    </HBox>
                    <Label styleClass="hint-label"
                           text="Sync a companion table from another database after the clone (e.g. a read_model populated by Kafka). The link column is remapped to the new root id and field overrides are applied. Saved per root table in config.json."/>
                    <TableView fx:id="tblSatellites" prefHeight="130" editable="true">
                        <columns>
                            <TableColumn fx:id="colSatSource" text="Source conn"  prefWidth="120"/>
                            <TableColumn fx:id="colSatTarget" text="Target conn"  prefWidth="120"/>
                            <TableColumn fx:id="colSatTable"  text="Table"        prefWidth="130"/>
                            <TableColumn fx:id="colSatLink"   text="Link column"  prefWidth="120"/>
                            <TableColumn fx:id="colSatPk"     text="PK column"    prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No satellite tables — clones stay within a single database."
                                   styleClass="placeholder-hint"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Log -->
                <VBox styleClass="card" spacing="8">
                    <Label text="%cc.log" styleClass="section-label"/>
                    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="14"/>
                    <Label fx:id="lblStatus" text="%status.ready" styleClass="status-label"/>
                    <TextArea fx:id="taLog" prefHeight="150" editable="false" wrapText="true"
                              styleClass="log-area" promptText=""/>
                    <Label fx:id="lblExportedPath" styleClass="hint-label" visible="false" managed="false"/>
                </VBox>

                <!-- Dry Run Results (hidden until preview runs) -->
                <?import javafx.scene.control.TableView?>
                <?import javafx.scene.control.TableColumn?>
                <VBox fx:id="dryRunPanel" styleClass="card" spacing="8"
                      visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="%cc.preview.title" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDryRunSummary" styleClass="hint-label"/>
                    </HBox>
                    <TableView fx:id="tblDryRun" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="colDryTable"  text="%cc.col.dry.table" prefWidth="240" minWidth="140"/>
                            <TableColumn fx:id="colDryRows"   text="%cc.col.dry.rows"  prefWidth="120" minWidth="80"/>
                            <TableColumn fx:id="colDryDepth"  text="%cc.col.dry.depth" prefWidth="90"  minWidth="60"/>
                        </columns>
                        <placeholder>
                            <Label text="%cc.preview.empty" styleClass="placeholder-hint"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="16" left="28"/></padding>
            <Button fx:id="btnClone"   text="%cc.btn.clone"   onAction="#onClone" styleClass="accent-btn"/>
            <Button fx:id="btnExport"  text="%cc.btn.export"  onAction="#onExport" disable="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnDryRun"  text="%cc.btn.preview" onAction="#onDryRun"/>
        </HBox>
    </bottom>

</BorderPane>
