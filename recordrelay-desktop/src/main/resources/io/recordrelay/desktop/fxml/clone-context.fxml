<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.CloneContextController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="28" right="28" bottom="12" left="28"/></padding>
            <Label text="Clone Context" styleClass="screen-title"/>
            <Label text="Source database'den bir kaydı ve tüm bağlı tablolarını dakikalar içinde hedefe kopyalar."
                   styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <VBox spacing="16">
                <padding><Insets top="4" right="28" bottom="16" left="28"/></padding>

                <!-- Step 1: Connections -->
                <VBox styleClass="card" spacing="10">
                    <Label text="ADIM 1 — BAĞLANTI SEÇ" styleClass="section-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Source (Kaynak Veritabanı)" styleClass="field-label"/>
                            <ComboBox fx:id="cmbSource" maxWidth="Infinity" onAction="#onSourceChanged"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTargetHeader" text="Target (Hedef Veritabanı)" styleClass="field-label"/>
                            <ComboBox fx:id="cmbTarget" maxWidth="Infinity"/>
                            <HBox fx:id="hboxOutputDir" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                                <TextField fx:id="tfOutputDir" HBox.hgrow="ALWAYS" promptText="Çıktı klasörü…"/>
                                <Button fx:id="btnBrowseDir" text="Seç…" onAction="#onBrowseDir"/>
                            </HBox>
                        </VBox>
                    </HBox>
                    <CheckBox fx:id="chkExportMode" text="Export modu — .rrpkg dosyası olarak kaydet (canlı kopyalama yapmaz)"/>
                </VBox>

                <!-- Step 2: Tables -->
                <VBox styleClass="card" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="ADIM 2 — TABLO &amp; KAYIT" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnLoadTables" text="Tabloları Yükle ↻" onAction="#onLoadTables"
                                disable="true"/>
                        <Label fx:id="lblTableCount" text="" styleClass="hint-label"/>
                    </HBox>
                    <Label text="Source seçildiğinde tablolar otomatik yüklenir. Başlangıç tablosunu ve kayıt ID'sini girin."
                           styleClass="screen-subtitle"/>
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Başlangıç Tablosu (root table)" styleClass="field-label"/>
                            <ComboBox fx:id="cmbRootTable" maxWidth="Infinity"
                                      promptText="Source seçince dolar…" editable="true"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="140">
                            <Label text="Primary Key Kolonu" styleClass="field-label"/>
                            <TextField fx:id="tfPkColumn" text="id" promptText="id"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Kayıt ID'si" styleClass="field-label"/>
                            <TextField fx:id="tfEntityId" promptText="örn. 12345"/>
                        </VBox>
                    </HBox>
                    <Label text="Sistem bu tablodan başlayarak FK ilişkilerini takip eder ve bağlı tüm kayıtları kopyalar."
                           styleClass="hint-label"/>
                </VBox>

                <!-- Step 3: Options -->
                <VBox styleClass="card" spacing="10">
                    <Label text="ADIM 3 — SEÇENEKLER" styleClass="section-label"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="İlişki derinliği (kaç tablo atlayacak)" styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Slider fx:id="sliderDepth" prefWidth="200"/>
                                <Label fx:id="lblDepthValue" text="3" styleClass="hint-label"/>
                            </HBox>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <CheckBox fx:id="chkMaskPii" text="PII Maskele (e-posta, telefon, adres, IBAN, TC kimlik)"/>
                    </HBox>
                </VBox>

                <!-- Step 4: Field Overrides -->
                <VBox styleClass="card" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="ADIM 4 — ALAN DEĞİŞTİRME (İSTEĞE BAĞLI)" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                        <Button text="+ Ekle" onAction="#onAddOverride"/>
                        <Button text="Sil" onAction="#onRemoveOverride"/>
                    </HBox>
                    <Label text="Hedef ortamda bazı alanların değerini değiştir (örn. created_by, mukellef_vkn). Tablo boş bırakılırsa tüm tablolara uygulanır."
                           styleClass="hint-label"/>
                    <TableView fx:id="tblOverrides" prefHeight="130" editable="true">
                        <columns>
                            <TableColumn fx:id="colOvrTable"  text="Tablo (boş=hepsi)" prefWidth="160"/>
                            <TableColumn fx:id="colOvrColumn" text="Kolon"              prefWidth="160"/>
                            <TableColumn fx:id="colOvrValue"  text="Yeni Değer"         prefWidth="200"/>
                        </columns>
                        <placeholder>
                            <Label text="Override yok — kayıtlar orijinal değerleriyle yazılır." styleClass="placeholder-hint"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Log -->
                <VBox styleClass="card" spacing="8">
                    <Label text="LOG" styleClass="section-label"/>
                    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="14"/>
                    <Label fx:id="lblStatus" text="Hazır" styleClass="status-label"/>
                    <TextArea fx:id="taLog" prefHeight="150" editable="false" wrapText="true"
                              styleClass="log-area" promptText="Kopyalama çıktısı burada görünür…"/>
                    <Label fx:id="lblExportedPath" styleClass="hint-label" visible="false" managed="false"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="16" left="28"/></padding>
            <Button fx:id="btnClone"  text="▶  Context Kopyala" onAction="#onClone" styleClass="accent-btn"/>
            <Button fx:id="btnExport" text="📦  Paket Dışa Aktar" onAction="#onExport" disable="true"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>

</BorderPane>
