<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.ConnectionsController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="28" right="28" bottom="12" left="28"/></padding>
            <Label text="%conn.title" styleClass="screen-title"/>
            <Label text="%conn.subtitle" styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" tableMenuButtonVisible="false">
            <padding><Insets left="28" right="28"/></padding>
            <columns>
                <TableColumn fx:id="colName"     text="%conn.col.name"     prefWidth="160" minWidth="100"/>
                <TableColumn fx:id="colType"     text="%conn.col.type"     prefWidth="120" minWidth="80"/>
                <TableColumn fx:id="colHost"     text="%conn.col.host"     prefWidth="180" minWidth="100"/>
                <TableColumn fx:id="colPort"     text="%conn.col.port"     prefWidth="70"  minWidth="50"/>
                <TableColumn fx:id="colDatabase" text="%conn.col.database" prefWidth="160" minWidth="80"/>
                <TableColumn fx:id="colUser"     text="%conn.col.user"     prefWidth="120" minWidth="60"/>
            </columns>
            <placeholder>
                <Label text="%conn.empty" styleClass="placeholder-hint"/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="16" left="28"/></padding>
            <Button text="%conn.btn.add"    onAction="#onAdd"    styleClass="accent-btn"/>
            <Button fx:id="btnEdit"   text="%conn.btn.edit"  onAction="#onEdit"/>
            <Button fx:id="btnTest"   text="%conn.btn.test"  onAction="#onTest"/>
            <Label  fx:id="lblStatus" text="%status.ready" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRemove" text="%conn.btn.remove" onAction="#onRemove" styleClass="danger-btn"/>
        </HBox>
    </bottom>

</BorderPane>
