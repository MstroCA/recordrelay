<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.ConnectionsController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="28" right="28" bottom="12" left="28"/></padding>
            <Label text="Connections" styleClass="screen-title"/>
            <Label text="Define and test database connection profiles."
                   styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" tableMenuButtonVisible="false">
            <padding><Insets left="28" right="28"/></padding>
            <columns>
                <TableColumn fx:id="colName"     text="Name"     prefWidth="160" minWidth="100"/>
                <TableColumn fx:id="colType"     text="Type"     prefWidth="120" minWidth="80"/>
                <TableColumn fx:id="colHost"     text="Host"     prefWidth="180" minWidth="100"/>
                <TableColumn fx:id="colPort"     text="Port"     prefWidth="70"  minWidth="50"/>
                <TableColumn fx:id="colDatabase" text="Database" prefWidth="160" minWidth="80"/>
                <TableColumn fx:id="colUser"     text="User"     prefWidth="120" minWidth="60"/>
            </columns>
            <placeholder>
                <Label text="No connections yet — click Add to create one."
                       styleClass="placeholder-hint"/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="16" left="28"/></padding>
            <Button text="Add…"            onAction="#onAdd"    styleClass="accent-btn"/>
            <Button fx:id="btnEdit"   text="Edit…"  onAction="#onEdit"/>
            <Button fx:id="btnTest"   text="Test Connection" onAction="#onTest"/>
            <Label  fx:id="lblStatus" text="Ready" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRemove" text="Remove" onAction="#onRemove" styleClass="danger-btn"/>
        </HBox>
    </bottom>

</BorderPane>
