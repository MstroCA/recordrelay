<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.DiscoveryController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="20" right="28" bottom="10" left="28"/></padding>
            <Label text="Schema Discovery" styleClass="screen-title"/>
            <Label text="Browse databases and tables to understand data structure."
                   styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.35">

            <!-- ── Left: connection / database / table selectors ──────── -->
            <VBox spacing="10" styleClass="discovery-panel" minWidth="240">
                <padding><Insets top="12" right="16" bottom="16" left="16"/></padding>

                <Label text="CONNECTION" styleClass="section-label"/>
                <ComboBox fx:id="cmbSrcConn" maxWidth="Infinity" onAction="#onSrcConnChanged"/>

                <Label text="Database" styleClass="field-label"/>
                <ComboBox fx:id="cmbSrcDb" maxWidth="Infinity" onAction="#onSrcDbChanged"/>

                <Label text="Table" styleClass="field-label"/>
                <ComboBox fx:id="cmbSrcTable" maxWidth="Infinity"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator/>

                <Button fx:id="btnDiscover" text="Inspect Columns"
                        maxWidth="Infinity" onAction="#onDiscover" styleClass="accent-btn"/>
                <Label fx:id="lblDiscoveryStatus" text="Ready" styleClass="status-label"/>
            </VBox>

            <!-- ── Right: column list ──────────────────────────────────── -->
            <VBox spacing="8">
                <padding><Insets top="12" right="16" bottom="16" left="12"/></padding>

                <Label text="Columns" styleClass="screen-subtitle-bold"/>

                <TableView fx:id="tblColumns" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName"      text="Column"    prefWidth="200" minWidth="100"/>
                        <TableColumn fx:id="colType"      text="Type"      prefWidth="160" minWidth="80"/>
                        <TableColumn fx:id="colNullable"  text="Nullable"  prefWidth="80"  minWidth="60"/>
                        <TableColumn fx:id="colPk"        text="PK"        prefWidth="50"  minWidth="40"/>
                    </columns>
                    <placeholder>
                        <Label text="Select a connection, database, and table, then click Inspect."
                               styleClass="placeholder-hint"/>
                    </placeholder>
                </TableView>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>
