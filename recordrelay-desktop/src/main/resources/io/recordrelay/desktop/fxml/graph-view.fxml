<?xml version="1.0" encoding="UTF-8"?>
<?import io.recordrelay.desktop.view.RelationshipGraphCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.GraphViewController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="20" right="28" bottom="10" left="28"/></padding>
            <Label text="Graph View" styleClass="screen-title"/>
            <Label text="Visual relationship graph — root table and its FK-connected dependencies."
                   styleClass="screen-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="graphScroll" fitToWidth="true" fitToHeight="true"
                    styleClass="graph-scroll" VBox.vgrow="ALWAYS">
            <RelationshipGraphCanvas fx:id="graphCanvas"/>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="8">
            <HBox spacing="10" styleClass="action-bar" alignment="CENTER_LEFT">
                <padding><Insets top="12" right="28" bottom="4" left="28"/></padding>
                <Label text="Connection:" styleClass="field-label"/>
                <ComboBox fx:id="cboSource" prefWidth="180"/>
                <Label text="Root table:" styleClass="field-label"/>
                <ComboBox fx:id="cboRootTable" prefWidth="180" editable="true"/>
                <Button fx:id="btnDiscover" text="Discover Graph" onAction="#onDiscover"
                        styleClass="accent-btn"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" text="Select a connection to begin." styleClass="status-label"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
