<?xml version="1.0" encoding="UTF-8"?>
<?import io.recordrelay.desktop.view.RelationshipGraphCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.GraphViewController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="20" right="28" bottom="10" left="28"/></padding>
            <Label text="%nav.graph.view" styleClass="screen-title"/>
            <Label text="%graph.subtitle" styleClass="screen-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="graphScroll" pannable="true" styleClass="graph-scroll">
            <Group>
                <RelationshipGraphCanvas fx:id="graphCanvas"/>
            </Group>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" styleClass="action-bar" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="%graph.lbl.conn" styleClass="field-label"/>
            <ComboBox fx:id="cboSource" prefWidth="160"/>
            <Label text="%graph.lbl.root" styleClass="field-label"/>
            <ComboBox fx:id="cboRootTable" prefWidth="160" editable="true"/>
            <Button fx:id="btnDiscover" text="%graph.btn.discover" onAction="#onDiscover"
                    styleClass="accent-btn"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="%graph.lbl.zoom" styleClass="field-label"/>
            <Button text="−" onAction="#onZoomOut"/>
            <Slider fx:id="sldZoom" min="0.25" max="2.5" value="1.0" prefWidth="110"
                    showTickMarks="false" blockIncrement="0.15"/>
            <Button text="+" onAction="#onZoomIn"/>
            <Button text="1:1" onAction="#onZoomReset"/>
            <Label fx:id="lblStatus" text="%graph.hint" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>
