<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="190" spacing="2">
            <padding><Insets top="16" right="8" bottom="8" left="8"/></padding>

            <Label text="%app.title" styleClass="sidebar-title"/>
            <Separator/>

            <Button text="%nav.clone.context" maxWidth="Infinity"
                    styleClass="nav-btn-accent" onAction="#showCloneContext"/>
            <Separator/>
            <Button text="%nav.environments" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showEnvironments"/>
            <Button text="%nav.connections" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showConnections"/>
            <Button text="%nav.discovery" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showDiscovery"/>
            <Button text="%nav.monitor" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showMonitor"/>
            <Button text="%nav.graph.view" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showGraphView"/>
            <Button text="%nav.migration.drift" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showMigrationDrift"/>
            <Button text="%nav.row.count.diff" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showRowCountDiff"/>
            <Button text="%nav.query" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showQuery"/>
            <Button text="%nav.connection.health" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showConnectionHealth"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>

            <Button fx:id="btnTheme" text="%theme.dark" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#toggleTheme"/>
            <Label fx:id="lblStatus" text="%status.ready" styleClass="status-label"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>
