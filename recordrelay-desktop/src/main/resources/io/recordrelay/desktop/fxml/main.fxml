<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="190" spacing="2">
            <padding><Insets top="16" right="8" bottom="8" left="8"/></padding>

            <Label text="RecordRelay" styleClass="sidebar-title"/>
            <Separator/>

            <Button text="⚡  Clone Context" maxWidth="Infinity"
                    styleClass="nav-btn-accent" onAction="#showCloneContext"/>
            <Separator/>
            <Button text="🌐  Environments" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showEnvironments"/>
            <Button text="🔌  Connections"  maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showConnections"/>
            <Button text="🔍  Discovery"    maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showDiscovery"/>
            <Button text="📊  Monitor"      maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showMonitor"/>
            <Button text="🕸  Graph View"   maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showGraphView"/>
            <Button text="⚠  Migration Drift" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showMigrationDrift"/>
            <Button text="🔢  Row Count Diff" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showRowCountDiff"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>

            <Button fx:id="btnTheme" text="🌙 Dark" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#toggleTheme"/>
            <Label fx:id="lblStatus" text="● Ready" styleClass="status-label"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>
