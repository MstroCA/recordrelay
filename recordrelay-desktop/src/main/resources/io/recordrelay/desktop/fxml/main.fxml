<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="2">
            <padding><Insets top="16" right="8" bottom="8" left="8"/></padding>

            <Label text="%app.title" styleClass="sidebar-title"/>
            <Separator/>

            <Button text="%nav.clone.context" maxWidth="Infinity"
                    styleClass="nav-btn-accent" onAction="#showCloneContext">
                <graphic><FontIcon iconLiteral="mdi2d-database-sync" iconSize="15"/></graphic>
            </Button>
            <Separator/>
            <Button fx:id="btnNavEnv" text="%nav.environments" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showEnvironments">
                <graphic><FontIcon iconLiteral="mdi2l-layers" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavConn" text="%nav.connections" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showConnections">
                <graphic><FontIcon iconLiteral="mdi2d-database" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavDisc" text="%nav.discovery" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showDiscovery">
                <graphic><FontIcon iconLiteral="mdi2m-magnify" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavMon" text="%nav.monitor" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showMonitor">
                <graphic><FontIcon iconLiteral="mdi2v-view-dashboard" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavGraph" text="%nav.graph.view" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showGraphView">
                <graphic><FontIcon iconLiteral="mdi2s-sitemap" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavDrift" text="%nav.migration.drift" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showMigrationDrift">
                <graphic><FontIcon iconLiteral="mdi2s-swap-horizontal" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavRowCnt" text="%nav.row.count.diff" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showRowCountDiff">
                <graphic><FontIcon iconLiteral="mdi2t-table" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavQuery" text="%nav.query" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showQuery">
                <graphic><FontIcon iconLiteral="mdi2c-code-braces" iconSize="15"/></graphic>
            </Button>
            <Button fx:id="btnNavHealth" text="%nav.connection.health" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#showConnectionHealth">
                <graphic><FontIcon iconLiteral="mdi2h-heart-pulse" iconSize="15"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>

            <ComboBox fx:id="cboLanguage" maxWidth="Infinity" onAction="#onLanguageChanged"/>
            <Button fx:id="btnTheme" text="%theme.dark" maxWidth="Infinity"
                    styleClass="nav-btn" onAction="#toggleTheme"/>
            <Label fx:id="lblStatus" text="%status.ready" styleClass="status-label"/>
            <Label fx:id="lblVersion" styleClass="hint-label"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>
