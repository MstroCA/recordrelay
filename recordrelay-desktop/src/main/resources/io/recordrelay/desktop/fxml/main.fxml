<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="210" spacing="0">

            <!-- ── Brand header ───────────────────────────────────────── -->
            <HBox styleClass="sidebar-brand" maxWidth="Infinity"
                  alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <ImageView fitWidth="26" fitHeight="26" preserveRatio="true"
                           pickOnBounds="true" smooth="true">
                    <image>
                        <Image url="@../icon-64.png"
                               requestedWidth="52" requestedHeight="52"
                               preserveRatio="true" smooth="true"/>
                    </image>
                </ImageView>
                <VBox spacing="1">
                    <Label text="RecordRelay" styleClass="sidebar-brand-name"/>
                    <Label text="DATABASE RELAY" styleClass="sidebar-brand-tagline"/>
                </VBox>
            </HBox>

            <!-- Kept for i18n refresh in MainController — not displayed -->
            <Label fx:id="lblSidebarTitle" visible="false" managed="false"/>

            <!-- ── Navigation items ───────────────────────────────────── -->
            <VBox spacing="2">
                <padding><Insets top="10" right="8" bottom="6" left="8"/></padding>

                <Button fx:id="btnNavCloneCtx" text="%nav.clone.context"
                        maxWidth="Infinity" styleClass="nav-btn-accent"
                        onAction="#showCloneContext">
                    <graphic><FontIcon iconLiteral="mdi2d-database-sync" iconSize="15"/></graphic>
                </Button>
                <Separator/>
                <Button fx:id="btnNavEnv" text="%nav.environments"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showEnvironments">
                    <graphic><FontIcon iconLiteral="mdi2l-layers" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavConn" text="%nav.connections"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showConnections">
                    <graphic><FontIcon iconLiteral="mdi2d-database" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavDisc" text="%nav.discovery"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showDiscovery">
                    <graphic><FontIcon iconLiteral="mdi2m-magnify" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavMon" text="%nav.monitor"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showMonitor">
                    <graphic><FontIcon iconLiteral="mdi2v-view-dashboard" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavGraph" text="%nav.graph.view"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showGraphView">
                    <graphic><FontIcon iconLiteral="mdi2s-sitemap" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavDrift" text="%nav.migration.drift"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showMigrationDrift">
                    <graphic><FontIcon iconLiteral="mdi2s-swap-horizontal" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavRowCnt" text="%nav.row.count.diff"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showRowCountDiff">
                    <graphic><FontIcon iconLiteral="mdi2t-table" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavQuery" text="%nav.query"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showQuery">
                    <graphic><FontIcon iconLiteral="mdi2c-code-braces" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavHealth" text="%nav.connection.health"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showConnectionHealth">
                    <graphic><FontIcon iconLiteral="mdi2h-heart-pulse" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavMaskCoverage" text="%nav.masking.coverage"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showMaskingCoverage">
                    <graphic><FontIcon iconLiteral="mdi2s-shield-check" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavPresets" text="%nav.presets"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showClonePresets">
                    <graphic><FontIcon iconLiteral="mdi2b-bookmark-multiple" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavSync" text="%nav.scheduled.sync"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showScheduledSync">
                    <graphic><FontIcon iconLiteral="mdi2c-clock-outline" iconSize="15"/></graphic>
                </Button>
                <Button fx:id="btnNavHelp" text="%nav.help"
                        maxWidth="Infinity" styleClass="nav-btn"
                        onAction="#showHelp">
                    <graphic><FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="15"/></graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- ── Bottom controls ───────────────────────────────────── -->
            <VBox spacing="4">
                <padding><Insets top="4" right="8" bottom="10" left="8"/></padding>
                <Separator/>
                <ComboBox fx:id="cboLanguage" maxWidth="Infinity"
                          onAction="#onLanguageChanged"/>
                <Button fx:id="btnTheme" text="%theme.dark" maxWidth="Infinity"
                        styleClass="nav-btn" onAction="#toggleTheme"/>
                <Label fx:id="lblStatus" text="%status.ready" styleClass="status-label"/>
                <Label fx:id="lblVersion" styleClass="hint-label"/>
            </VBox>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>
