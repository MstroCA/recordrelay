<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.recordrelay.desktop.view.RowCountDiffController">

    <top>
        <VBox spacing="4">
            <padding><Insets top="20" right="28" bottom="10" left="28"/></padding>
            <Label text="%rcd.title" styleClass="screen-title"/>
            <Label text="%rcd.subtitle" styleClass="screen-subtitle"/>
            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
        <VBox spacing="12">
            <padding><Insets top="4" right="28" bottom="16" left="28"/></padding>

            <!-- ── Selector row ──────────────────────────────────────────────── -->
            <HBox spacing="16" styleClass="card" alignment="CENTER_LEFT">

                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="%rcd.section.source" styleClass="section-label"/>
                    <Label text="%rcd.lbl.conn" styleClass="field-label"/>
                    <ComboBox fx:id="cmbSrcConn" maxWidth="Infinity" onAction="#onSrcConnChanged"/>
                    <Label text="%rcd.lbl.db" styleClass="field-label"/>
                    <ComboBox fx:id="cmbSrcDb"   maxWidth="Infinity"/>
                </VBox>

                <Separator orientation="VERTICAL" prefHeight="110"/>

                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="%rcd.section.target" styleClass="section-label"/>
                    <Label text="%rcd.lbl.conn" styleClass="field-label"/>
                    <ComboBox fx:id="cmbTgtConn" maxWidth="Infinity" onAction="#onTgtConnChanged"/>
                    <Label text="%rcd.lbl.db" styleClass="field-label"/>
                    <ComboBox fx:id="cmbTgtDb"   maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="130">
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnCompare" text="%rcd.btn.compare"
                            maxWidth="Infinity" onAction="#onCompare" styleClass="accent-btn"/>
                    <Label fx:id="lblStatus" text="%status.ready" styleClass="status-label"/>
                </VBox>

            </HBox>

            <!-- ── Summary chips ─────────────────────────────────────────────── -->
            <HBox fx:id="hboxSummary" spacing="12" visible="false" managed="false" alignment="CENTER_LEFT">
                <Label fx:id="lblChipSync"    styleClass="drift-chip-missing"/>
                <Label fx:id="lblChipBehind"  styleClass="drift-chip-extra"/>
                <Label fx:id="lblChipAhead"   styleClass="drift-chip-mismatch"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblChipTotal"   styleClass="hint-label"/>
            </HBox>

            <!-- ── Results table ─────────────────────────────────────────────── -->
            <TableView fx:id="tblCounts" prefHeight="400" minHeight="200">
                <columns>
                    <TableColumn fx:id="colTable"   text="%rcd.col.table"     prefWidth="220" minWidth="140"/>
                    <TableColumn fx:id="colSource"  text="%rcd.col.src.rows"  prefWidth="140" minWidth="100"/>
                    <TableColumn fx:id="colTarget"  text="%rcd.col.tgt.rows"  prefWidth="140" minWidth="100"/>
                    <TableColumn fx:id="colDiff"    text="%rcd.col.diff"      prefWidth="110" minWidth="80"/>
                    <TableColumn fx:id="colStatus"  text="%rcd.col.status"    prefWidth="140" minWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="%rcd.empty" styleClass="placeholder-hint"/>
                </placeholder>
            </TableView>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
