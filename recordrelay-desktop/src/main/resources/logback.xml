<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <property name="LOG_DIR"   value="${user.home}/.recordrelay/logs"/>
  <property name="LOG_FILE"  value="${LOG_DIR}/recordrelay.log"/>
  <property name="PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{jobId:--}] [%thread] %logger{36} - %msg%n"/>
  <property name="CONSOLE_PATTERN"
            value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%X{jobId:--})] %gray(%logger{28}) - %msg%n"/>

  <!-- Rolling file: keeps 30 days / 500 MB total -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/recordrelay.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <timeBasedFileNamingAndTriggeringPolicy
          class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
        <maxFileSize>50MB</maxFileSize>
      </timeBasedFileNamingAndTriggeringPolicy>
      <maxHistory>30</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Console: colored, human-readable -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Silence noisy third-party libraries -->
  <logger name="com.zaxxer.hikari"              level="WARN"/>
  <logger name="org.hibernate"                  level="WARN"/>
  <logger name="com.datastax.oss.driver"        level="WARN"/>
  <logger name="org.mongodb.driver"             level="WARN"/>
  <logger name="co.elastic.clients"             level="WARN"/>
  <logger name="redis.clients.jedis"            level="WARN"/>
  <logger name="org.apache.parquet"             level="WARN"/>
  <logger name="org.apache.poi"                 level="WARN"/>
  <logger name="javafx"                         level="WARN"/>

  <!-- RecordRelay application -->
  <logger name="io.recordrelay" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="FILE"/>
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
